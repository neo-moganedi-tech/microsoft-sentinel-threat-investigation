
datatable(
    TimeGenerated: datetime,
    Account: string,
    EventID: int,
    SourceIP: string
)
[
    datetime(2026-11-07T08:00:00Z), "j.mokoena", 4625, "203.0.113.50",
    datetime(2026-11-07T08:01:00Z), "j.mokoena", 4625, "203.0.113.50",
    datetime(2026-11-07T08:02:00Z), "j.mokoena", 4625, "203.0.113.50",
    datetime(2026-11-07T08:03:00Z), "j.mokoena", 4625, "203.0.113.50",
    datetime(2026-11-07T08:05:00Z), "j.mokoena", 4624, "203.0.113.50",
    datetime(2026-11-07T08:12:00Z), "svc_backup", 4625, "198.51.100.25",
    datetime(2026-11-07T08:13:00Z), "svc_backup", 4625, "198.51.100.25"
]
| where EventID == 4625
| summarize
    FailedAttempts = count(),
    FirstFailure = min(TimeGenerated),
    LastFailure = max(TimeGenerated)
    by Account, SourceIP
| where FailedAttempts >= 3
| join kind=inner (
    datatable(
        TimeGenerated: datetime,
        Account: string,
        EventID: int,
        SourceIP: string
    )
    [
        datetime(2026-11-07T08:05:00Z), "j.mokoena", 4624, "203.0.113.50"
    ]
    | where EventID == 4624
    | project
        Account,
        SourceIP,
        SuccessfulLogin = TimeGenerated
) on Account, SourceIP
| where SuccessfulLogin > LastFailure
| project
    Account,
    SourceIP,
    FailedAttempts,
    FirstFailure,
    LastFailure,
    SuccessfulLogin
